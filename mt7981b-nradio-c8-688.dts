/dts-v1/;

#include "mt7981b.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
	model = "NRadio C8-688";
	compatible = "nradio,c8-688", "mediatek,mt7981b", "mediatek,mt7981";

	aliases {
		serial0 = &uart0;
		led-boot = &led_status;
		led-failsafe = &led_status;
		led-running = &led_status;
		led-upgrade = &led_status;
	};

	chosen {
		/* 严格对齐 Slot B 的 rootfs 实际挂载分区 mmcblk0p9 */
		bootargs = "console=ttyS0,115200n8 root=/dev/mmcblk0p9 rootwait rootfstype=squashfs,f2fs,ext4";
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0 0x40000000 0 0x40000000>; /* 1024MB (1GB) RAM */
	};

	keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			gpios = <&pio 1 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_status: status {
			label = "blue:status";
			gpios = <&pio 9 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};

		net {
			label = "green:net";
			gpios = <&pio 10 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
	};

	/* 为 luci-app-h5000m-fancontrol 提供底层的 hwmon pwm-fan 设备接口 */
	fan: pwm-fan {
		compatible = "pwm-fan";
		pwms = <&pwm 0 50000 0>;
		cooling-levels = <0 64 128 192 255>;
		#cooling-cells = <2>;
		status = "okay";
	};
};

/* 定义芯片引脚复用 (Pinctrl) */
&pio {
	emmc_pins: emmc-pins {
		mux {
			function = "emmc";
			groups = "emmc_51";
		};
	};

	pwm0_pins: pwm0-pins {
		mux {
			function = "pwm";
			groups = "pwm0";
		};
	};
};

&uart0 {
	status = "okay";
};

&watchdog {
	status = "okay";
};

/* 以太网 MAC 控制器 */
&eth {
	status = "okay";

	gmac0: mac@0 {
		compatible = "mediatek,eth-mac";
		reg = <0>;
		phy-mode = "2500base-x";
		phy-handle = <&phy_ext>;
	};

	gmac1: mac@1 {
		compatible = "mediatek,eth-mac";
		reg = <1>;
		phy-mode = "gmii";
		phy-handle = <&phy0>;
	};
};

/* MDIO 总线与 PHY 映射 */
&mdio_bus {
	status = "okay";

	phy0: ethernet-phy@0 {
		compatible = "ethernet-phy-id03a2.9461";
		reg = <0>;
		phy-mode = "gmii";
	};

	phy_ext: ethernet-phy@1 {
		reg = <1>;
		phy-mode = "2500base-x";
		reset-gpios = <&pio 7 GPIO_ACTIVE_LOW>;
		reset-assert-us = <10000>;
		reset-deassert-us = <20000>;
	};
};

&mmc0 {
	pinctrl-names = "default";
	pinctrl-0 = <&emmc_pins>;
	bus-width = <8>;
	max-frequency = <52000000>;
	cap-mmc-highspeed;
	non-removable;
	status = "okay";
};

&usb_phy {
	status = "okay";
};

&xhci {
	status = "okay";
};

/* 激活硬件 PWM 控制器并绑定引脚 */
&pwm {
	pinctrl-names = "default";
	pinctrl-0 = <&pwm0_pins>;
	status = "okay";
};

/* 激活 MT7981 内置 Wi-Fi 模块 */
&wifi {
	status = "okay";
};